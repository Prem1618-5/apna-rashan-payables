# Copy to terraform.tfvars (kept out of git) and edit.
# Only alert_email is required; everything else has a default.

alert_email        = "owner@example.com"
monthly_budget_usd = 60

# First-run owner account (the PIN is a secret: put-secrets.sh SEED_OWNER_PIN)
seed_owner_name  = "Owner"
seed_owner_phone = "9000000001"

# HDFC ENet client code from your relationship manager
hdfc_client_code = "ARAD01"

# How many Gemini keys you have (1-3). Each needs a value in Secrets Manager.
gemini_api_key_count = 1
# Free Gemini tiers may train on what we send, so real invoices are blocked
# from them. Switch to "paid" once billing is enabled on the key.
gemini_tier = "free"
# textract_enabled = true

# Start small; autoscaling adds tasks up to max_count on high CPU.
# task_cpu      = 256
# task_memory   = 512
# desired_count = 1
# max_count     = 3

# Custom domain (optional). Certificate must be in us-east-1.
# domain_names        = ["pay.example.in"]
# acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/..."

# Copy automated DB backups to Hyderabad (extra cost)
# enable_backup_replication = true

# GitHub Actions deploy role. Set create_github_oidc_provider = false if the
# account already has the token.actions.githubusercontent.com provider.
# github_repo                 = "Prem1618-5/apna-rashan-payables"
# create_github_oidc_provider = true
