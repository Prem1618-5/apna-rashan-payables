# Copy to .env for local dev. In AWS these come from the task definition + Secrets Manager.
# Twelve-factor: every setting is an environment variable; nothing else is read at runtime.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# Absolute or repo-relative path of the built PWA that the API serves (empty = don't serve).
WEB_DIST=apps/web/dist
# Run the background extraction worker inside the API process (beta default).
RUN_WORKER=true

# Postgres
DATABASE_URL=postgres://arad:arad@localhost:5432/arad

# Invoice images: "fs" (local folder) or "s3"
STORAGE_DRIVER=fs
STORAGE_DIR=data/uploads
S3_BUCKET=
AWS_REGION=ap-south-1

# Secrets (generate: openssl rand -base64 32)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
DATA_ENCRYPTION_KEY=

# AI extraction. Keys live only here / in Secrets Manager, never in the web app.
# Several keys per provider are tried in order when one hits a limit.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-flash-latest
# Node 22 fetch only honours HTTPS_PROXY with this set (needed behind corporate/sandbox proxies).
NODE_USE_ENV_PROXY=1
# Second reader when only one AI vendor is available (different model, same vendor).
GEMINI_SECOND_MODEL=gemini-3.5-flash
# "free" tiers may train on what we send; real invoices are blocked from them by default.
GEMINI_TIER=free
TEXTRACT_ENABLED=false
# "synthetic" for dev/test data, "real" once real invoices are captured.
DATA_CLASS=synthetic
AI_ALLOW_TRAINING_PROVIDERS_FOR_REAL_DATA=false
# "auto" = use configured providers; "mock" = deterministic fake (tests/demo)
EXTRACTOR=auto

# HDFC bulk file
HDFC_CLIENT_CODE=ARAD01
RTGS_FROM_PAISE=20000000
COOLING_OFF_HOURS=24
REQUIRE_DIFFERENT_APPROVER=true

# First run only: creates the owner account if no users exist.
SEED_OWNER_NAME=Owner
SEED_OWNER_PHONE=9000000001
SEED_OWNER_PIN=
