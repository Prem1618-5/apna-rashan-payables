# Rebuilt inside the image
**/node_modules
**/dist
**/coverage
**/.turbo
**/*.tsbuildinfo

# Git, editors, agents
.git
.github
.claude
.vscode
.idea
**/.DS_Store

# Data, generated files and anything real: never in the image
data
**/data
**/out
**/*.real.json
**/screenshots
**/playwright-report
**/test-results
**/blob-report

# Secrets and local config
.env
.env.*
!.env.example
**/*.pem
**/*.key

# Infra state and docs (not needed at runtime)
infra/aws
docs
docker-compose.yml
Dockerfile
.dockerignore
